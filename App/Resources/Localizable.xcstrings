          }
        }
      }
    },
    "Shared or synced items": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריטים משותפים או מסונכרנים"
          }
        }
      }
    },
    "Shows the system permission dialog.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג את חלון ההרשאה של המערכת."
          }
        }
      }
    },
    "Shrinking": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכווץ"
          }
        }
      }
    },
    "Shrinking them would free almost nothing.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כיווץ שלהם כמעט לא יפנה מקום."
          }
        }
      }
    },
    "Shrinking twice would lower quality.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כיווץ כפול יפגע באיכות."
          }
        }
      }
    },
    "Shrunk": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כווצו"
          }
        }
      }
    },
    "Slow-motion timing would be lost.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תזמון ההילוך האיטי היה הולך לאיבוד."
          }
        }
      }
    },
    "Slow-motion videos": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרטוני הילוך איטי"
          }
        }
      }
    },
    "Smaller copies save": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העותקים הקטנים חוסכים"
          }
        }
      }
    },
    "Some originals couldn't be deleted. Nothing was lost; you can try again from the home screen.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מהמקורות לא נמחקו. שום דבר לא אבד; אפשר לנסות שוב מהמסך הראשי."
          }
        }
      }
    },
    "Something went wrong while reading your library. Nothing was changed.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש בקריאת הספרייה. שום דבר לא שונה."
          }
        }
      }
    },
    "Space freed": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקום שפונה"
          }
        }
      }
    },
    "Space freed so far": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקום שפונה עד עכשיו"
          }
        }
      }
    },
    "Space is almost full. Delete the originals processed so far to continue.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האחסון כמעט מלא. כדי להמשיך, מחקו את המקורות שכבר עובדו."
          }
        }
      }
    },
    "Space is running low": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האחסון עומד להיגמר"
          }
        }
      }
    },
    "Spatial photos and videos": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות וסרטונים מרחביים"
          }
        }
      }
    },
    "Start": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחלה"
          }
        }
      }
    },
    "Started. Large files go first.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחלנו. קבצים גדולים קודם."
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עצירה"
          }
        }
      }
    },
    "Stop now?": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לעצור עכשיו?"
          }
        }
      }
    },
    "Stopped": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נעצר"
          }
        }
      }
    },
    "Stored only in iCloud": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמורים רק ב‑iCloud"
          }
        }
      }
    },
    "That album or item is no longer in your library.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האלבום או הפריט כבר לא נמצאים בספרייה."
          }
        }
      }
    },
    "The editable focus track would be lost.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסלול הפוקוס הניתן לעריכה היה הולך לאיבוד."
          }
        }
      }
    },
    "The photo and its short video must stay linked. Support is planned.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה והסרטון הקצר שלה חייבים להישאר מקושרים. התמיכה מתוכננת."
          }
        }
      }
    },
    "The real result is measured for every file. Anything that doesn't pass the quality check is left untouched.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוצאה האמיתית נמדדת לכל קובץ. קובץ שלא עובר את בדיקת האיכות נשאר כמו שהוא."
          }
        }
      }
    },
    "The smaller copies are in the MediaSlim album. Your originals are untouched.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העותקים הקטנים נמצאים באלבום MediaSlim. המקורות לא שונו."
          }
        }
      }
    },
    "The smaller copy is added to the MediaSlim album and nothing is deleted. Space is freed only when you delete originals yourself.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העותק הקטן מתווסף לאלבום MediaSlim ושום דבר לא נמחק. מקום יתפנה רק כשמוחקים את המקורות ידנית."
          }
        }
      }
    },
    "The smaller copy takes the original's place, with the same date, location and albums. After you confirm, originals move to Recently Deleted for 30 days.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העותק הקטן נכנס במקום המקור, עם אותו תאריך, מיקום ואלבומים. אחרי אישור, המקורות עוברים ל'נמחקו לאחרונה' ל‑30 יום."
          }
        }
      }
    },
    "These belong to a shared album or another device.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הם שייכים לאלבום משותף או למכשיר אחר."
          }
        }
      }
    },
    "These items are already efficient, or are types MediaSlim leaves as they are.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריטים האלה כבר יעילים, או מסוגים ש‑MediaSlim משאירה כמו שהם."
          }
        }
      }
    },
    "These items are stored only in iCloud.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריטים האלה שמורים רק ב‑iCloud."
          }
        }
      }
    },
    "Turn on access to all photos for MediaSlim in Settings.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להפעיל בהגדרות גישה לכל התמונות עבור MediaSlim."
          }
        }
      }
    },
    "Turn on iCloud downloads in Settings to include them.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לכלול אותם, יש להפעיל בהגדרות הורדה מ‑iCloud."
          }
        }
      }
    },
    "Unfinished run": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סבב שלא הסתיים"
          }
        }
      }
    },
    "Usually received through a messaging app. Shrinking again would lower quality.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדרך כלל התקבלו באפליקציית הודעות. כיווץ נוסף יפגע באיכות."
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסה"
          }
        }
      }
    },
    "Videos": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרטונים"
          }
        }
      }
    },
    "Waiting for your confirmation": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממתין לאישור"
          }
        }
      }
    },
    "What should MediaSlim shrink?": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה לכווץ?"
          }
        }
      }
    },
    "Whole Library": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל הספרייה"
          }
        }
      }
    },
    "Working files are encrypted and deleted after each item.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובצי עבודה מוצפנים ונמחקים אחרי כל פריט."
          }
        }
      }
    },
    "Working on a photo": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעבד תמונה"
          }
        }
      }
    },
    "Working on a video": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעבד סרטון"
          }
        }
      }
    },
    "You choose what to shrink, and you confirm before any original is deleted.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתם בוחרים מה לכווץ ומאשרים לפני שמקור כלשהו נמחק."
          }
        }
      }
    },
    "You chose not to delete %lld originals, so no space was freed yet. Both versions are in your library.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרתם לא למחוק %lld מקורות, ולכן עוד לא התפנה מקום. שתי הגרסאות נמצאות בספרייה."
          }
        }
      }
    },
    "You'll see an estimate before anything changes.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפני שמשהו משתנה תוצג הערכה."
          }
        }
      }
    },
    "Your iPhone is warm. MediaSlim continues when it cools down.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האייפון חם. MediaSlim תמשיך כשהוא יתקרר."
          }
        }
      }
    },
    "Your photos and videos are not touched.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונות והסרטונים שלך לא נפגעים."
          }
        }
      }
    },
    "iOS asks you to approve deleting the originals.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS יבקש לאשר את מחיקת המקורות."
          }
        }
      }
    }
  },
  "version": "1.0"
}
