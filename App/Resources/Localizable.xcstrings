    "Review": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סקירה"
          }
        }
      }
    },
    "Select specific photos and videos": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחירה של תמונות וסרטונים מסוימים"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "he": {
